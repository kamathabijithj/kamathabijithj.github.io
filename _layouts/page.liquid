---
layout: default
---
<div class="post academic-inner-page">
  <header class="post-header academic-page-header">
    <h1 class="post-title academic-page-title">{{ page.title | capitalize }}</h1>
    {% if page.description %}<p class="post-description academic-page-description">{{ page.description }}</p>{% endif %}
  </header>

  <article class="academic-page-content">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
