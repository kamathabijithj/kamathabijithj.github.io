{% assign basics = data[1] %}
<div class="cv-profile-block">
  <h4 class="cv-profile-name">{{ basics.name }}</h4>
  <p class="cv-profile-role">{{ basics.label }}</p>
  <p class="cv-profile-affiliation">Biomedical Imaging Group, EPFL · CIBM Center for Biomedical Imaging</p>
  <p class="cv-profile-summary">{{ basics.summary }}</p>
  <div class="cv-profile-links" aria-label="Contact links">
    {% if basics.email %}<a href="mailto:{{ basics.email }}">{{ basics.email }}</a>{% endif %}
    {% if basics.url %}<a href="{{ basics.url }}" target="_blank" rel="noopener noreferrer">{{ basics.url | remove: 'https://' | remove: 'http://' }}</a>{% endif %}
    {% if basics.location and basics.location.address %}
      <address class="cv-profile-address">
        {{ basics.location.address }} · {{ basics.location.postalCode }} {{ basics.location.city }} · {% if basics.location.countryCode == 'CH' %}Switzerland{% else %}{{ basics.location.countryCode }}{% endif %}
      </address>
    {% endif %}
  </div>
</div>
