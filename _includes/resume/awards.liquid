<ol class="cv-record-list">
  {% for content in data[1] %}
    <li class="cv-record-item">
      {% if content.date %}<time class="cv-record-date">{{ content.date | split: '-' | first }}</time>{% endif %}
      <div class="cv-record-body">
        <h4 class="cv-record-title">
          {% if content.url and content.url != '' %}<a href="{{ content.url }}">{{ content.title }}</a>{% else %}{{ content.title }}{% endif %}
        </h4>
        {% if content.awarder %}<p class="cv-record-meta">{{ content.awarder }}</p>{% endif %}
        {% if content.summary and content.summary != '' %}<p class="cv-record-summary">{{ content.summary }}</p>{% endif %}
      </div>
    </li>
  {% endfor %}
</ol>
