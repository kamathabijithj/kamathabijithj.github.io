<ol class="cv-record-list">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="cv-record-item">
      {% if content.startDate %}
        {% assign startDate = content.startDate | split: '-' | first %}
        {% assign endDate = content.endDate | split: '-' | first | default: 'Present' %}
        <time class="cv-record-date">{{ startDate }}—{{ endDate }}</time>
      {% endif %}
      <div class="cv-record-body">
        <h4 class="cv-record-title">
          {% if content.url and content.url != '' %}<a href="{{ content.url }}">{{ content.position }}</a>{% else %}{{ content.position }}{% endif %}
        </h4>
        {% if content.name %}<p class="cv-record-meta">{{ content.name }}</p>{% endif %}
        {% if content.summary %}<p class="cv-record-summary">{{ content.summary }}</p>{% endif %}
        {% if content.highlights and content.highlights.size > 0 %}
          <ul class="cv-record-details">
            {% for item in content.highlights %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ol>
