---
layout: default
---

<div class="post">
  <article class="academic-home">
    <header id="top" class="academic-hero">
      <div class="academic-hero-copy">
        <p class="academic-kicker">{{ page.subtitle }}</p>
        <h1 class="academic-name">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</h1>
        <p class="academic-role">Postdoctoral researcher at EPFL</p>
        <p class="academic-affiliation">
          <a href="https://bigwww.epfl.ch/" target="_blank" rel="noopener">Biomedical Imaging Group</a>
          <span aria-hidden="true">/</span>
          <a href="https://cibm.ch" target="_blank" rel="noopener">CIBM</a>
          <span aria-hidden="true">/</span>
          Lausanne, Switzerland
        </p>
        <nav class="academic-actions" aria-label="Academic profiles and contact">
          <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener">Google Scholar <span aria-hidden="true">↗</span></a>
          <a href="https://orcid.org/{{ site.orcid_id }}" target="_blank" rel="noopener">ORCID <span aria-hidden="true">↗</span></a>
          <a href="{{ '/assets/pdf/cv.pdf' | relative_url }}">CV <span aria-hidden="true">↓</span></a>
          <a href="mailto:{{ site.email | encode_email }}">Email</a>
        </nav>
      </div>

      {% if page.profile_image %}
        <div class="academic-portrait">
          {% assign profile_image_path = page.profile_image | prepend: 'assets/img/' %}
          {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 280px, 62vw" alt="Portrait of Abijith J. Kamath" cache_bust=true %}
        </div>
      {% endif %}
    </header>

    <section id="about" class="academic-introduction" aria-labelledby="about-heading">
      <div class="academic-section-index">
        <h2 id="about-heading">Profile</h2>
      </div>
      <div class="academic-prose">{{ content }}</div>
    </section>

    {% if page.news and site.announcements.enabled %}
      <section id="news" class="page-section">
        <div class="section-header">
          <div class="academic-section-index"><h2 class="section-label">News</h2></div>
          <a class="section-more-link" href="{{ '/news/' | relative_url }}">all news →</a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section id="research" class="page-section">
        <div class="section-header">
          <div class="academic-section-index"><h2 class="section-label">Selected work</h2></div>
          <a class="section-more-link" href="{{ '/publications/' | relative_url }}">all publications →</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if site.latest_posts.enabled %}
      <section class="page-section">
        <div class="section-header">
          <h2 class="section-label">Posts</h2>
          <a class="section-more-link" href="{{ '/blog/' | relative_url }}">all posts →</a>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <section id="contact" class="page-section">
      <div class="academic-section-index"><h2 class="section-label contact-section-label">Contact</h2></div>
      <div class="contact-grid">
        <p class="contact-address">{{ site.contact_note }}</p>
        <div>
          <p class="contact-email"><a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a></p>
          <div class="contact-social">{% include social.liquid %}</div>
        </div>
      </div>
    </section>
  </article>
</div>
